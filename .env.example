# 聊天上游(DeepSeek 官方,OpenAI 协议)。CHAT_MODEL 要写上游认的真实模型名
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat
CHAT_API_KEY=sk-xxx

TOKEN_BUDGET=2000
DATABASE_URL=mysql+pymysql://mewhelp:mewhelp_local@127.0.0.1:3307/mewhelp?charset=utf8mb4

# 知识库嵌入服务（OpenAI 兼容）。空值允许聊天服务照常启动，向量化时才报缺失。
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=knowledge_ch04
RECALL_TOP_K=50
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=10
RERANK_MIN_SCORE=0.0
RAG_TOP_K=5
RAG_MIN_SCORE=0.55
# JSON array of exact knowledge_ch04 category values. Empty means no category filter.
RAG_CATEGORY_ALLOWLIST=[]

# Ch05 shared per-turn limits, including intent and retrieval model requests.
AGENT_MAX_TOOL_STEPS=5
AGENT_MAX_MODEL_CALLS=6
AGENT_MAX_TOKENS=12000
AGENT_TIMEOUT_SECONDS=120
WORKFLOW_GATE_THRESHOLD=0.032755612017354
WORKFLOW_CHECKPOINT_PATH=data/runtime/ch05-checkpoints.sqlite

# Optional small intent model, same chat upstream; empty uses main model
INTENT_SMALL_MODEL=
INTENT_CONFIDENCE_THRESHOLD=0.75

# Ch08 MCP runtime
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTER_SALES_URL=http://127.0.0.1:8102/mcp
TOOL_POLICY_PATH=config/tool_policy.json
TOOL_PLUGINS_PATH=config/tool_plugins.json
